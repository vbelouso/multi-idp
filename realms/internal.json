{
  "realm": "internal",
  "enabled": true,
  "sslRequired": "all",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "defaultSignatureAlgorithm": "RS256",
  "accessTokenLifespan": 90,
  "eventsEnabled": true,
  "eventsListeners": [
    "jboss-logging"
  ],
  "enabledEventTypes": [
    "LOGIN",
    "LOGIN_ERROR",
    "CLIENT_LOGIN",
    "CLIENT_LOGIN_ERROR",
    "TOKEN_EXCHANGE",
    "TOKEN_EXCHANGE_ERROR",
    "FEDERATED_IDENTITY_LINK",
    "FEDERATED_IDENTITY_LINK_ERROR",
    "JWT_AUTHORIZATION_GRANT",
    "JWT_AUTHORIZATION_GRANT_ERROR"
  ],
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": false,
  "roles": {
    "realm": [
      {
        "name": "invoke-b"
      },
      {
        "name": "invoke-c"
      }
    ]
  },
  "clients": [
    {
      "clientId": "realm-provisioner",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": true,
      "defaultClientScopes": [],
      "optionalClientScopes": [],
      "secret": "${PROVISIONER_SECRET}",
      "clientAuthenticatorType": "client-secret",
      "protocolMappers": [
        {
          "name": "realm administration roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "config": {
            "usermodel.clientRoleMapping.clientId": "realm-management",
            "claim.name": "resource_access.realm-management.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "realm management audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "realm-management",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "agent-a-internal",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "defaultClientScopes": [
        "identity"
      ],
      "optionalClientScopes": [
        "partner.invoke",
        "c.invoke",
        "extra"
      ],
      "secret": "${AGENT_SECRET}",
      "clientAuthenticatorType": "client-secret",
      "attributes": {
        "oauth2.jwt.authorization.grant.enabled": "true",
        "oauth2.jwt.authorization.grant.idp": "rh-sso",
        "use.refresh.tokens": "false",
        "access.token.lifespan": "600",
        "standard.token.exchange.enabled": "true",
        "oauth2.jwt.authorization.grant.audience": "[{\"key\": \"rh-sso\", \"value\": \"cloud-services\"}]"
      }
    },
    {
      "clientId": "unapproved-agent",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "defaultClientScopes": [
        "identity"
      ],
      "optionalClientScopes": [
        "partner.invoke",
        "c.invoke",
        "extra"
      ],
      "secret": "${OTHER_AGENT_SECRET}",
      "clientAuthenticatorType": "client-secret",
      "attributes": {
        "oauth2.jwt.authorization.grant.enabled": "true",
        "oauth2.jwt.authorization.grant.idp": "rh-sso",
        "use.refresh.tokens": "false",
        "access.token.lifespan": "600",
        "standard.token.exchange.enabled": "true",
        "oauth2.jwt.authorization.grant.audience": "[{\"key\": \"rh-sso\", \"value\": \"cloud-services\"}]"
      }
    },
    {
      "clientId": "agent-c",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "defaultClientScopes": [],
      "optionalClientScopes": []
    },
    {
      "clientId": "${EXTERNAL_ISSUER}",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "defaultClientScopes": [],
      "optionalClientScopes": []
    }
  ],
  "clientScopes": [
    {
      "name": "partner.invoke",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true"
      },
      "protocolMappers": [
        {
          "name": "partner.invoke audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "${EXTERNAL_ISSUER}",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "name": "extra",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true"
      }
    },
    {
      "name": "c.invoke",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true"
      },
      "protocolMappers": [
        {
          "name": "c.invoke audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "agent-c",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "name": "identity",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "local permissions",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "permissions",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "origin_issuer",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "origin_issuer",
            "claim.name": "origin_issuer",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "origin_sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "origin_sub",
            "claim.name": "origin_sub",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "internal_sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "internal_sub",
            "claim.name": "internal_sub",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "provenance_version",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "provenance_version",
            "claim.name": "provenance_version",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "scopeMappings": [
    {
      "clientScope": "partner.invoke",
      "roles": [
        "invoke-b"
      ]
    },
    {
      "clientScope": "c.invoke",
      "roles": [
        "invoke-c"
      ]
    }
  ],
  "users": [
    {
      "id": "11111111-1111-4111-8111-111111111111",
      "username": "pilot",
      "enabled": true,
      "realmRoles": [
        "invoke-b",
        "invoke-c"
      ],
      "requiredActions": []
    }
  ],
  "identityProviders": [
    {
      "alias": "rh-sso",
      "providerId": "jwt-authorization-grant",
      "enabled": true,
      "hideOnLogin": true,
      "config": {
        "issuer": "${UPSTREAM_ISSUER}",
        "jwksUrl": "${UPSTREAM_JWKS}",
        "useJwksUrl": "true",
        "jwtAuthorizationGrantEnabled": "true",
        "jwtAuthorizationGrantAssertionReuseAllowed": "false",
        "jwtAuthorizationGrantMaxAllowedAssertionExpiration": "${MAX_ASSERTION_LIFETIME}",
        "jwtAuthorizationGrantAssertionSignatureAlg": "${ASSERTION_ALGORITHM}",
        "jwtAuthorizationGrantLimitAccessTokenExp": "true"
      }
    }
  ],
  "clientProfiles": {
    "profiles": [
      {
        "name": "assertion-boundaries",
        "executors": [
          {
            "executor": "downscope-assertion-grant-enforcer",
            "configuration": {}
          },
          {
            "executor": "jwt-claim-enforcer",
            "configuration": {
              "claim-name": "azp",
              "allowed-value": "^agent-a-internal$"
            }
          }
        ]
      }
    ]
  },
  "clientPolicies": {
    "policies": [
      {
        "name": "assertion-boundaries",
        "enabled": true,
        "conditions": [
          {
            "condition": "grant-type",
            "configuration": {
              "grant_types": [
                "urn:ietf:params:oauth:grant-type:token-exchange"
              ]
            }
          }
        ],
        "profiles": [
          "assertion-boundaries"
        ]
      }
    ]
  },
  "attributes": {
    "multi-idp-owner": "multi-idp-poc",
    "multi-idp-revision": "${REVISION}",
    "multi-idp-bootstrap": "pending"
  }
}
