{
  "realm": "partner",
  "enabled": true,
  "sslRequired": "all",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "defaultSignatureAlgorithm": "RS256",
  "accessTokenLifespan": 90,
  "eventsEnabled": true,
  "eventsListeners": [
    "jboss-logging"
  ],
  "enabledEventTypes": [
    "LOGIN",
    "LOGIN_ERROR",
    "CLIENT_LOGIN",
    "CLIENT_LOGIN_ERROR",
    "TOKEN_EXCHANGE",
    "TOKEN_EXCHANGE_ERROR",
    "FEDERATED_IDENTITY_LINK",
    "FEDERATED_IDENTITY_LINK_ERROR",
    "JWT_AUTHORIZATION_GRANT",
    "JWT_AUTHORIZATION_GRANT_ERROR"
  ],
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": false,
  "roles": {
    "realm": [
      {
        "name": "invoke-b"
      },
      {
        "name": "invoke-c"
      }
    ]
  },
  "clients": [
    {
      "clientId": "realm-provisioner",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": true,
      "defaultClientScopes": [],
      "optionalClientScopes": [],
      "secret": "${PROVISIONER_SECRET}",
      "clientAuthenticatorType": "client-secret",
      "protocolMappers": [
        {
          "name": "realm administration roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "config": {
            "usermodel.clientRoleMapping.clientId": "realm-management",
            "claim.name": "resource_access.realm-management.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "realm management audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "realm-management",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "agent-a-external",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "defaultClientScopes": [
        "identity",
        "partner.invoke"
      ],
      "optionalClientScopes": [
        "extra"
      ],
      "secret": "${AGENT_SECRET}",
      "clientAuthenticatorType": "client-secret",
      "attributes": {
        "oauth2.jwt.authorization.grant.enabled": "true",
        "oauth2.jwt.authorization.grant.idp": "internal",
        "use.refresh.tokens": "false",
        "access.token.lifespan": "90"
      },
      "consentRequired": true
    },
    {
      "clientId": "unapproved-agent",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "defaultClientScopes": [
        "identity",
        "partner.invoke"
      ],
      "optionalClientScopes": [
        "extra"
      ],
      "secret": "${OTHER_AGENT_SECRET}",
      "clientAuthenticatorType": "client-secret",
      "attributes": {
        "oauth2.jwt.authorization.grant.enabled": "true",
        "oauth2.jwt.authorization.grant.idp": "internal",
        "use.refresh.tokens": "false",
        "access.token.lifespan": "90"
      }
    },
    {
      "clientId": "agent-b",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "defaultClientScopes": [],
      "optionalClientScopes": []
    }
  ],
  "clientScopes": [
    {
      "name": "partner.invoke",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true"
      }
    },
    {
      "name": "extra",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true"
      }
    },
    {
      "name": "identity",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "local permissions",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "permissions",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "origin_issuer",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "origin_issuer",
            "claim.name": "origin_issuer",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "origin_sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "origin_sub",
            "claim.name": "origin_sub",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "internal_sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "internal_sub",
            "claim.name": "internal_sub",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "provenance_version",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "provenance_version",
            "claim.name": "provenance_version",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "partner.invoke audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "agent-b",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "scopeMappings": [
    {
      "clientScope": "partner.invoke",
      "roles": [
        "invoke-b"
      ]
    }
  ],
  "users": [
    {
      "id": "22222222-2222-4222-8222-222222222222",
      "username": "pilot",
      "enabled": true,
      "realmRoles": [
        "invoke-b"
      ],
      "requiredActions": [],
      "federatedIdentities": [
        {
          "identityProvider": "internal",
          "userId": "11111111-1111-4111-8111-111111111111",
          "userName": "pilot"
        }
      ],
      "clientConsents": [
        {
          "clientId": "agent-a-external",
          "grantedClientScopes": [
            "partner.invoke"
          ]
        }
      ]
    }
  ],
  "identityProviders": [
    {
      "alias": "internal",
      "providerId": "jwt-authorization-grant",
      "enabled": true,
      "hideOnLogin": true,
      "config": {
        "issuer": "${INTERNAL_ISSUER}",
        "jwksUrl": "${INTERNAL_JWKS}",
        "useJwksUrl": "true",
        "jwtAuthorizationGrantEnabled": "true",
        "jwtAuthorizationGrantAssertionReuseAllowed": "false",
        "jwtAuthorizationGrantMaxAllowedAssertionExpiration": "600",
        "jwtAuthorizationGrantAssertionSignatureAlg": "${ASSERTION_ALGORITHM}",
        "jwtAuthorizationGrantLimitAccessTokenExp": "true"
      }
    }
  ],
  "clientProfiles": {
    "profiles": [
      {
        "name": "assertion-boundaries",
        "executors": [
          {
            "executor": "downscope-assertion-grant-enforcer",
            "configuration": {}
          },
          {
            "executor": "jwt-claim-enforcer",
            "configuration": {
              "claim-name": "azp",
              "allowed-value": "^agent-a-internal$"
            }
          }
        ]
      }
    ]
  },
  "clientPolicies": {
    "policies": [
      {
        "name": "assertion-boundaries",
        "enabled": true,
        "conditions": [
          {
            "condition": "grant-type",
            "configuration": {
              "grant_types": [
                "urn:ietf:params:oauth:grant-type:jwt-bearer"
              ]
            }
          }
        ],
        "profiles": [
          "assertion-boundaries"
        ]
      }
    ]
  },
  "attributes": {
    "multi-idp-owner": "multi-idp-poc",
    "multi-idp-revision": "${REVISION}",
    "multi-idp-bootstrap": "pending"
  }
}
